# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Server-side Gemini API key used by the multi-agent review pipeline.
# Set this in the Convex deployment environment; never expose it as VITE_*.
GEMINI_API_KEY=

# Optional Gemini model override.
GEMINI_MODEL=gemini-3.6-flash

# Optional GitHub token for higher API rate limits/private-repository access.
# Public repositories can be reviewed without it.
GITHUB_TOKEN=
